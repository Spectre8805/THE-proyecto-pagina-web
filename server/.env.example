PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Genera un valor aleatorio largo para producción. Nunca lo subas a GitHub.
JWT_SECRET=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_LARGO
ADMIN_EMAIL=admin@ecosnacks.local
# Genera con: npm run hash-password -- "tu-contraseña-larga"
ADMIN_PASSWORD_HASH=PEGA_AQUI_EL_HASH_GENERADO
# Opcional: sin esta clave, el asistente usa respuestas locales.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# En producción configura una ruta persistente para la base de datos.
DATABASE_PATH=./ecosnacks.sqlite
